# Copy to .env beside docker-compose.yml for real-host deployments.
# Every value below is required or has a deliberate default (PLAN.md §2:
# production deployments set variables explicitly).

# Exact public origin the browser uses, including scheme. The API rejects
# mutating requests whose Origin does not match it (CSRF), and the session
# cookie's Secure flag requires HTTPS here.
APP_ORIGIN=https://fit.example.com

# Must stay true for any remote/production origin; the API refuses to start
# with a non-Secure cookie outside local development/test environments.
COOKIE_SECURE=true

# Environment label: development | test | qa | production.
APP_ENV=production

# Login session lifetime in seconds (default 24 h).
SESSION_TTL_SECONDS=86400

# Host bind for the container port. Keep the loopback default and terminate
# TLS in the host's reverse proxy.
BASEFIT_BIND=127.0.0.1:8000
